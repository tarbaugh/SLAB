units metal
atom_style atomic
boundary p p p
read_data random.data
pair_style soft 2.5
pair_coeff * * 0.0
variable prefactor equal ramp(0.0,30.0)
fix push all adapt 1 pair soft a * * v_prefactor
fix lim all nve/limit 0.05
velocity all create 300.0 4928459 dist gaussian
timestep 0.001
thermo 1000
run 5000
unfix push
unfix lim
pair_style lj/cut 8.5
pair_coeff * * 0.0104 3.40
min_style cg
minimize 1.0e-8 1.0e-8 5000 10000
write_data pushed.data
