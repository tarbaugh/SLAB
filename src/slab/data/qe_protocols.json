{
  "schema_version": 1,
  "source": "Values adapted from aiida-quantumespresso v4.10 pw protocols (MIT license, Copyright (c) 2016-2025 EPFL, THEOS / NCCR MARVEL). Protocol names fast/balanced/stringent follow the v4.10 rename of moderate/precise.",
  "units": {
    "kpoints_distance": "1/angstrom (reciprocal-space spacing including the 2*pi factor)",
    "degauss": "Ry",
    "conv_thr_per_atom": "Ry/atom",
    "etot_conv_thr_per_atom": "Ry/atom",
    "forc_conv_thr": "Ry/bohr"
  },
  "protocols": {
    "fast": {
      "description": "Quick check at the expense of accuracy: coarse k-mesh, loose thresholds.",
      "kpoints_distance": 0.3,
      "degauss": 0.0275,
      "smearing": "cold",
      "conv_thr_per_atom": 4e-10,
      "etot_conv_thr_per_atom": 1e-4,
      "forc_conv_thr": 1e-3,
      "mixing_beta": 0.4,
      "electron_maxstep": 80,
      "pseudo_family": "SSSP/1.3/PBEsol/efficiency"
    },
    "balanced": {
      "description": "Balanced accuracy and speed for most production runs (AiiDA's default).",
      "kpoints_distance": 0.15,
      "degauss": 0.02,
      "smearing": "cold",
      "conv_thr_per_atom": 2e-10,
      "etot_conv_thr_per_atom": 1e-5,
      "forc_conv_thr": 1e-4,
      "mixing_beta": 0.4,
      "electron_maxstep": 80,
      "pseudo_family": "SSSP/1.3/PBEsol/efficiency"
    },
    "stringent": {
      "description": "High accuracy at higher cost: dense k-mesh, tight thresholds, precision pseudopotentials.",
      "kpoints_distance": 0.1,
      "degauss": 0.0125,
      "smearing": "cold",
      "conv_thr_per_atom": 1e-10,
      "etot_conv_thr_per_atom": 5e-6,
      "forc_conv_thr": 5e-5,
      "mixing_beta": 0.4,
      "electron_maxstep": 80,
      "pseudo_family": "SSSP/1.3/PBEsol/precision"
    }
  }
}
